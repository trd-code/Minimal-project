<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="วาดทับหน้าจอ 🎨"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ขีดเขียนลอยทับได้ทุกแอปและทุกหน้าจอ\n\nวิธีใช้:\n1) กด ‘เริ่มวาดทับหน้าจอ’\n2) ครั้งแรกจะให้เปิดสิทธิ์ ‘แสดงบนแอปอื่น’ — เปิดแล้วกลับมากดเริ่มอีกครั้ง\n3) แถบเครื่องมือลอยจะโผล่มา ลากย้ายได้ที่ปุ่ม ⠿\n\nปุ่มบนแถบเครื่องมือ:\n✏️ / ✋  สลับ วาด ↔ แตะทะลุไปใช้แอปข้างล่าง\n🎨  เลือกสี (วงล้อสีอิสระ + สีหลัก + สีที่ใช้ล่าสุด)\n↶  ลบเส้นล่าสุด\n🗑  ล้างทั้งหมด\n🔍+ / 🔍−  ซูมขยาย/ย่อ ‘ทั้งหน้าจอ’ (ทุกแอป)\n\nซูมทั้งจอต้องเปิดสิทธิ์ Accessibility ครั้งเดียว (กดปุ่มด้านล่าง)\n\n➖  ย่อเหลือปุ่มลอยเล็ก (พักไว้ใช้แอปอื่น) แตะปุ่มลอยเพื่อกางกลับ\n✕  ปิด"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.2"
            android:paddingBottom="28dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="เริ่มวาดทับหน้าจอ"
            android:textSize="18sp"
            android:paddingVertical="14dp" />

        <Button
            android:id="@+id/btnZoomPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="เปิดสิทธิ์ซูมทั้งจอ (Accessibility)"
            android:textSize="16sp"
            android:paddingVertical="14dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="หยุด"
            android:textSize="18sp"
            android:paddingVertical="14dp" />
    </LinearLayout>
</ScrollView>
